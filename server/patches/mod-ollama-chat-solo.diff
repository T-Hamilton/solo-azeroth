+    // Keep the first spoken line; if a later line opens with another
+    // "Name:", the model kept the transcript going and the rest is not ours.
+    std::string CutAtNextSpeakerLine(const std::string& text)
+    {
+        std::string out;
+        size_t pos = 0;
+        bool haveFirst = false;
+        while (pos <= text.size())
+        {
+            size_t nl = text.find('\n', pos);
+            std::string line = text.substr(pos, nl == std::string::npos ? std::string::npos : nl - pos);
+            const bool blank = Trim(line).empty();
+            if (haveFirst && !blank && SpeakerPrefixLength(line) > 0)
+                break;
+            if (!blank)
