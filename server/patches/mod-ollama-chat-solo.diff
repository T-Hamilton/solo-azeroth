+// --- scope transcript and engagement (solo-azeroth) -----------------------
+
+void Governor_RecordTranscript(const std::string& scopeKey, ObjectGuid speaker,
+                               const std::string& speakerName, bool speakerIsBot,
+                               const std::string& text)
+{
+    if (text.empty() || g_TranscriptLines == 0)
+        return;
+
+    TranscriptLine line;
+    line.guid  = speaker.GetRawValue();
+    line.name  = speakerName;
+    line.isBot = speakerIsBot;
+    line.text  = text.size() > 220 ? text.substr(0, 220) : text;
+    line.when  = Clock::now();
+
+    std::lock_guard<std::mutex> lock(g_mutex);
+    ScopeState& scope = g_scopes[scopeKey];
+    scope.lastLine = line.when;
+    scope.transcript.push_back(std::move(line));
+    while (scope.transcript.size() > g_TranscriptLines)
+        scope.transcript.pop_front();
+}
+
+std::string Governor_TranscriptText(const std::string& scopeKey)
+{
+    std::lock_guard<std::mutex> lock(g_mutex);
+    auto it = g_scopes.find(scopeKey);
+    if (it == g_scopes.end())
+        return std::string();
+
+    const TimePoint now = Clock::now();
+    std::string out;
+    for (const TranscriptLine& line : it->second.transcript)
+    {
+        if (SecondsSince(line.when, now) > double(g_TranscriptWindowSeconds))
+            continue;
+        out += line.name;
+        out += ": ";
+        out += line.text;
+        out += '\n';
+    }
+    if (!out.empty())
+        out.pop_back();
+    return out;
+}
+
+double Governor_ScopeIdleSeconds(const std::string& scopeKey)
+{
+    std::lock_guard<std::mutex> lock(g_mutex);
+    auto it = g_scopes.find(scopeKey);
+    if (it == g_scopes.end())
+        return 1e9;
+    return SecondsSince(it->second.lastLine, Clock::now());
+}
+
+void Governor_NoteEngagement(ObjectGuid a, ObjectGuid b, const std::string& scopeKey)
+{
+    if (!a || !b || a == b || g_EngagedWindowSeconds == 0)
+        return;
+
+    const TimePoint now = Clock::now();
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_bots[a.GetRawValue()].engaged[b.GetRawValue()][scopeKey] = now;
+    g_bots[b.GetRawValue()].engaged[a.GetRawValue()][scopeKey] = now;
+}
+
+bool Governor_Engaged(ObjectGuid a, ObjectGuid b, const std::string& scopeKey)
+{
+    if (!a || !b || g_EngagedWindowSeconds == 0)
+        return false;
+
+    std::lock_guard<std::mutex> lock(g_mutex);
+    auto botIt = g_bots.find(a.GetRawValue());
+    if (botIt == g_bots.end())
+        return false;
+    auto otherIt = botIt->second.engaged.find(b.GetRawValue());
+    if (otherIt == botIt->second.engaged.end())
+        return false;
+    auto scopeIt = otherIt->second.find(scopeKey);
+    if (scopeIt == otherIt->second.end())
+        return false;
+    return SecondsSince(scopeIt->second, Clock::now()) <= double(g_EngagedWindowSeconds);
+}
+
