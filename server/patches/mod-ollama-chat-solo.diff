+    // solo-azeroth: the Q4 abliterated model now and then drops the letter
+    // after an apostrophe ("it' the best way", "let' go"), and once such a
+    // line sits in the shared transcript every later bot copies the habit.
+    // Restore the unambiguous cases: stems that in chat only ever take 's.
+    // "I'" / "they'" / "we'" stay as they are (could be 'm, 've, 're, 'd).
+    std::string RepairContractions(const std::string& text)
+    {
+        static const char* const stems[] = {
+            "it", "that", "what", "there", "here", "let", "who", "where", "how",
+            "he", "she", "everyone", "someone", "everything", "nothing",
+            "something", "anyone", "this"
+        };
+
+        std::string out;
+        out.reserve(text.size() + 8);
+
+        for (size_t i = 0; i < text.size(); ++i)
+        {
+            const char c = text[i];
+            if (c != '\'' || i == 0 || !std::isalpha(static_cast<unsigned char>(text[i - 1])))
+            {
+                out.push_back(c);
+                continue;
+            }
+
+            const bool boundary = (i + 1 >= text.size()) ||
+                                  IsSpace(static_cast<unsigned char>(text[i + 1])) ||
+                                  std::strchr(".,!?;:\")-", text[i + 1]) != nullptr;
+            if (!boundary)
+            {
+                out.push_back(c);
+                continue;
+            }
+
+            size_t ws = out.size();
+            while (ws > 0 && std::isalpha(static_cast<unsigned char>(out[ws - 1])))
+                --ws;
+            std::string word = out.substr(ws);
+            for (char& ch : word)
+                ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+
+            bool hit = false;
+            for (const char* s : stems)
+                if (word == s) { hit = true; break; }
+
+            out.push_back('\'');
+            if (hit)
+                out.push_back('s');
+        }
+
+        return out;
+    }
+
+    // solo-azeroth: "Okay, here we go... <line>", "Right, here's my reply: <line>",
+    // "Here's my line: <line>". The model announces the line before typing it;
+    // drop the announcement when it ends in a colon or an ellipsis close to the
+    // start, and only when something is left.
+    std::string StripLeadIn(const std::string& text)
+    {
+        const size_t window = std::min<size_t>(text.size(), 48);
+        std::string lower = text.substr(0, window);
+        for (char& ch : lower)
+            ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+
+        static const char* const tells[] = {
+            "here's my", "here is my", "my reply", "my line", "my response",
+            "here we go", "here goes", "here's what i'd say"
+        };
+
+        size_t tell = std::string::npos;
+        for (const char* t : tells)
+        {
+            const size_t p = lower.find(t);
+            if (p != std::string::npos && (tell == std::string::npos || p < tell))
+                tell = p;
+        }
+        if (tell == std::string::npos)
+            return text;
+
+        size_t end = std::string::npos;
+        const size_t limit = std::min(text.size(), tell + 40);
+        for (size_t i = tell; i < limit; ++i)
+        {
+            if (text[i] == ':')
+            {
+                end = i + 1;
+                break;
+            }
+            if (text[i] == '.' && i + 1 < text.size() && text[i + 1] == '.')
+            {
+                size_t j = i;
+                while (j < text.size() && text[j] == '.')
+                    ++j;
+                end = j;
+                break;
+            }
+        }
+        if (end == std::string::npos)
+            return text;
+
+        std::string rest = Trim(text.substr(end));
+        return rest.size() >= 8 ? rest : text;
+    }
+}
