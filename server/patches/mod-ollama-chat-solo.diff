+// solo-azeroth: nearest real player of this bot's faction on the same map, or nullptr.
+Player* OllamaWorldSnapshot::NearestRealPlayerOnMap(Player* who) const
+{
+    if (!who || !who->IsInWorld())
+        return nullptr;
+
+    Player* best = nullptr;
+    float bestDist = 0.0f;
+    for (Player* player : realPlayers)
+    {
+        if (player == who || !player->IsInWorld())
+            continue;
+        if (player->GetMapId() != who->GetMapId() || player->GetTeamId() != who->GetTeamId())
+            continue;
+        const float d = who->GetDistance(player);
+        if (!best || d < bestDist)
+        {
+            best = player;
+            bestDist = d;
+        }
+    }
+    return best;
+}
